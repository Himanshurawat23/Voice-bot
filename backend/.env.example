# ==============================================================================
# LiveKit Voice Agent & Token Server Environment Configuration (Example)
# ==============================================================================

# === LiveKit Cloud / Server Credentials ===
# Sign up for free at https://cloud.livekit.io (10,000 free participant minutes/month)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# === Deepgram (STT & TTS) ===
# Free credits available at https://deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_STT_MODEL=nova-2-general
DEEPGRAM_TTS_MODEL=aura-2-asteria-en
DEEPGRAM_STT_LANGUAGE=en
DEEPGRAM_STT_SAMPLE_RATE=16000
DEEPGRAM_TTS_SAMPLE_RATE=24000

# === Groq (LLM) ===
# Free API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.7
# Token burn prevention: limit max output tokens & sliding window history
GROQ_MAX_TOKENS=100
MAX_CHAT_HISTORY=6

# === FastAPI Token Server ===
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# === Neural Noise Cancellation ===
# Models: BVC (Background Voice Cancellation) or NC (Enhanced Neural Noise Cancellation)
LIVEKIT_NOISE_CANCELLATION=true
LIVEKIT_NOISE_CANCELLATION_MODEL=BVC
